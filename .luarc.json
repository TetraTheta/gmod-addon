{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "diagnostics": {
    "disable": ["duplicate-set-field", "undefined-global"],
    "neededFileStatus": {
      "codestyle-check": "Any"
    }
  },
  "runtime": {
    "nonstandardSymbol": ["!", "!=", "&&", "/**/", "//", "continue", "||"],
    "version": "LuaJIT",
    "special": {
      "include": "require",
      "IncludeCS": "require"
    }
  },
  "workspace": {
    "checkThirdParty": false,
    "ignoreDir": [".luals", ".vscode"],
    "library": [".luals/addons/garrysmod/library"]
  },
  "format": {
    "defaultConfig": {
      "indent_size": "2",
      "indent_style": "space"
    }
  }
}
